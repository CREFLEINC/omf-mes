{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(/raw/**)",
      "Write(raw/**)",
      "Edit(/raw/**)",
      "Edit(raw/**)",
      "NotebookEdit(/raw/**)",
      "NotebookEdit(raw/**)",
      "Edit(/planning/versions/**)",
      "Edit(planning/versions/**)",
      "NotebookEdit(/planning/versions/**)",
      "NotebookEdit(planning/versions/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_readonly.py\""
          }
        ]
      }
    ]
  }
}

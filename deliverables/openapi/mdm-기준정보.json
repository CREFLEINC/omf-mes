          "name": "locationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "tags": [
          "mdm"
        ],
        "summary": "Location 상세",
        "description": "근거: W-06-07 §4-B · 공유계약 B-4(참조 건수를 응답에 담는다 — 화면이 세지 않는다)",
        "responses": {
          "200": {
            "description": "상세",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationDetailResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "mdm"
        ],
        "summary": "Location 수정",
        "description": "행 선택 → 인스펙터/Dialog 편집. 근거: W-06-07 §4-B 편집 열 · §3 · 공유계약 B-1(낙관적 잠금 — 덮어쓰기 강제는 제공하지 않는다)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatchVersion"
          }
        ],

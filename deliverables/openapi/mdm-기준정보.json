              }
            }
          },
          "403": {
            "description": "권한 없음. 근거: W-06-07 §6 · §8-8(편집 권한 매트릭스는 미결)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "충돌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictResponse"
                }
              }
            }
          }
        }

{
  "openapi": "3.1.0",
  "info": {
    "title": "omf-mes 기준정보 도메인 API (초안)",
    "version": "0.1.0",
    "description": "화면 상세 스펙 확대 1차에서 도출한 계약 초안. 정본은 물리 모델이며 이 문서는 그것을 옮긴 것이다. 근거·맥락은 deliverables/06-API-요구서.md 를 본다. WBS P0.4 API 계약 v0 의 초안 입력이며 계약 확정·소유는 통합 Agent 소관이다. 마스터 형 패턴의 「변경 이력」 엔드포인트는 이슈 #68 해소 후에 추가한다. `audit.audit_event` 는 실재하나(공유계약 B-5) `target_id` 가 FK 가 아니고 `before_value`/`after_value` jsonb 의 키 규약이 없어, 지금 응답 스키마를 만들면 필드를 지어내게 된다."
  },
  "servers": [
    {
      "url": "/api",
      "description": "온프레미스 설치형"
    }
  ],
  "tags": [
    {
      "name": "mdm",
      "description": "기준정보 마스터"
    },
    {
      "name": "app",
      "description": "사용자·권한"
    },
    {
      "name": "planning",
      "description": "공정 순서·BOM"
    },
    {
      "name": "quality",
      "description": "품질 기준"
    },
    {
      "name": "integration",
      "description": "ERP 연계 실행"
    },
    {
      "name": "audit",
      "description": "변경 이력"
    },
    {
      "name": "lookup",
      "description": "선택 목록 — 관리 화면이 없는 조회 전용"
    }
  ],
  "paths": {
    "/mdm/warehouses": {
      "get": {
        "tags": [
          "mdm"
        ],
        "summary": "창고 목록",
        "description": "근거: W-06-07 §3 좌측 목록 · 공유계약 G-8(유효성 판정은 서버가 한다)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "코드·명칭 검색"
          },
          {
            "name": "warehouseTypeCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeInactive",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "기본은 사용 중인 것만. 과거 데이터 표시용으로 켜면 isActive 표식을 함께 내린다"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Warehouse"
                      }
                    },
                    "page": {
                      "$ref": "#/components/schemas/PageMeta"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "mdm"
        ],
        "summary": "창고 등록",
        "description": "근거: W-06-07 §5-1 「창고 추가」 · 공유계약 A-1(유일 위반은 범위를 담아 응답)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WarehouseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Warehouse"
                }
              }
            }
          },
          "400": {
            "description": "검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음. 근거: W-06-07 §6 · §8-8(편집 권한 매트릭스는 미결)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mdm/warehouses/{warehouseId}": {
      "parameters": [
        {
          "name": "warehouseId",
          "in": "path",
          "required": true,
          "schema": {
